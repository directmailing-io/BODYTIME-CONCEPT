# ============================================================
# BODYTIME concept – Environment Variables
# Kopiere diese Datei nach .env.local und trage die echten Werte ein.
# NIEMALS .env.local in die Versionskontrolle einchecken.
# ============================================================

# ---- App-URL (muss auf die echte Domain gesetzt werden) ----
# Lokal: http://localhost:3000
# Produktion: https://bodytime-concept.de
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase (öffentlich – sicher für den Client) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Supabase (nur Server – NIEMALS an den Client weitergeben) ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- E-Mail via Resend (nur Server) ----
# API-Key aus dem Resend-Dashboard: https://resend.com
RESEND_API_KEY=re_your_resend_api_key
# Absender – muss eine in Resend verifizierte Domain-Adresse sein
EMAIL_FROM=info@bodytime-concept.de

# ---- Cron / Hintergrund-Jobs ----
# Beliebiges sicheres Zufalls-Passwort als Bearer-Token
# Generieren: openssl rand -hex 32
CRON_SECRET=your-secure-random-secret
